# ==============================================================================
# CivicPulse Mobile (Expo) — environment
# Copy to .env.local and fill in. Only EXPO_PUBLIC_* values reach the app bundle.
# ==============================================================================

# --- Existing Supabase project (same one the web app uses) --------------------
# Public anon key only. NEVER put SUPABASE_SERVICE_ROLE_KEY in the mobile app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# --- Existing Next.js backend ------------------------------------------------
# Android emulator reaches the host machine at 10.0.2.2, not localhost.
# Local dev (emulator):  http://10.0.2.2:3000
# Local dev (device):    http://<your-lan-ip>:3000
# Production (Cloud Run): https://civicpulse-<hash>-as.a.run.app
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# --- Native Android Maps SDK key (OPTIONAL) ----------------------------------
# Must be a key restricted to Android apps (package org.civicpulse.app + SHA-1).
# If omitted, the map screen falls back to the list/coordinates view.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=

# --- Deep link used for OAuth / magic-link redirects --------------------------
# Must also be added to Supabase: Authentication > URL Configuration >
# Redirect URLs. Format: <scheme>://<path>
EXPO_PUBLIC_AUTH_REDIRECT=civicpulse://auth-callback
