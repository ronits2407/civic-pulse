# ==============================================================================
# CivicPulse Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase (Database, Auth, Storage, Vector Embeddings)
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your-service-role-key...

# ------------------------------------------------------------------------------
# 2. Google Gemini AI (LangGraph Agents 0-5)
# Obtain from: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...your-gemini-api-key...
AI_PROVIDER=gemini
# 'flash' is recommended for local development to avoid rate limits; 'pro' for deep reasoning
GEMINI_AGENT5_MODEL=flash

# ------------------------------------------------------------------------------
# 3. Google Maps Platform (Google Cloud Platform)
# Obtain from: Google Cloud Console -> APIs & Services -> Credentials
# Required GCP APIs to enable in your project:
#   1. Geocoding API (used for address resolution in /api/geocode)
#   2. Routes API (used for field crew route optimization in /api/admin/routes/optimize)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-key...
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...your-google-maps-key...

# ------------------------------------------------------------------------------
# 4. Mapbox (Optional)
# Note: The UI currently renders using Leaflet + OpenStreetMap Carto.
# A dummy placeholder works for local testing.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.placeholder

# ------------------------------------------------------------------------------
# 5. Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Web Push Notifications (Optional for local testing)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@civicpulse.org
